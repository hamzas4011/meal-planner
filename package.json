{
  "name": "meal-planner",
  "private": true,
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,green --kill-others \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "dotnet run --project MealPlanner.Api",
    "dev:web": "npm --prefix meal-planner-web run dev",
    "test": "dotnet test MealPlanner.Api.Tests -c Release"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
